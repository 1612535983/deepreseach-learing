# 任意兼容 OpenAI Chat Completions 协议的模型服务都可以接入。
# 下面以 DeepSeek 为例；不要把真实密钥提交到 Git。
DEEPRESEARCH_API_KEY=sk-your-api-key
DEEPRESEARCH_MODEL=deepseek-chat
DEEPRESEARCH_BASE_URL=https://api.deepseek.com

# 长期记忆默认关闭。改为 default 后使用 Markdown truth store + BM25 召回。
DEEPRESEARCH_MEMORY_USE=
DEEPRESEARCH_MEMORY_STORAGE_PATH=.deepresearch/memory
DEEPRESEARCH_MEMORY_NAMESPACE=default
DEEPRESEARCH_MEMORY_ENABLE_RECALL=true
DEEPRESEARCH_MEMORY_ENABLE_EXTRACT=false
DEEPRESEARCH_MEMORY_TOKEN_BUDGET=2000
DEEPRESEARCH_MEMORY_TOP_K=5
DEEPRESEARCH_MEMORY_MIN_STRENGTH=0.0
DEEPRESEARCH_MEMORY_FORGET_THRESHOLD=0.1
DEEPRESEARCH_MEMORY_TTL_HOURS=720
DEEPRESEARCH_MEMORY_CONSOLIDATE_THRESHOLD=10
DEEPRESEARCH_MEMORY_WORKER_QUEUE_SIZE=32

# Skill 默认关闭。改为 default 后加载内置与 DEEPRESEARCH_SKILL_DIRS 中的 SKILL.md。
DEEPRESEARCH_SKILL_USE=
DEEPRESEARCH_SKILL_DB_PATH=.deepresearch/skills.db
DEEPRESEARCH_SKILL_STORAGE_PATH=.deepresearch/skills/objects
DEEPRESEARCH_SKILL_DIRS=skills
DEEPRESEARCH_SKILL_INCLUDE_BUILTIN=true
DEEPRESEARCH_SKILL_MAX_SKILLS=3
DEEPRESEARCH_SKILL_TOKEN_BUDGET=2500
DEEPRESEARCH_SKILL_MIN_RELEVANCE=0.05
DEEPRESEARCH_SKILL_MAX_FILE_CHARS=50000
DEEPRESEARCH_SKILL_ENABLE_METRICS=true

# Jev 概率评估默认关闭。先用 shadow 只观测，再确认阈值后切换 gate。
DEEPRESEARCH_EVALUATION_USE=
DEEPRESEARCH_EVALUATION_MODE=shadow
DEEPRESEARCH_JEV_API_KEY=
DEEPRESEARCH_JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
DEEPRESEARCH_JEV_MODEL=jev-latest
DEEPRESEARCH_JEV_TIMEOUT_SECONDS=15
DEEPRESEARCH_JEV_MAX_RETRIES=1
DEEPRESEARCH_JEV_RETRY_BACKOFF_SECONDS=0.25
DEEPRESEARCH_EVALUATION_MAX_PAYLOAD_CHARS=40000
DEEPRESEARCH_EVALUATION_MAX_REPORT_CHARS=20000
DEEPRESEARCH_EVALUATION_MAX_EVIDENCE_ITEMS=12
DEEPRESEARCH_EVALUATION_MAX_EVIDENCE_CHARS=1200
DEEPRESEARCH_EVALUATION_MAX_GATE_ATTEMPTS=1
DEEPRESEARCH_EVALUATION_ANSWER_RELEVANCE_THRESHOLD=0.75
DEEPRESEARCH_EVALUATION_EVIDENCE_SUPPORT_THRESHOLD=0.75
DEEPRESEARCH_EVALUATION_CITATION_COVERAGE_THRESHOLD=0.70
DEEPRESEARCH_EVALUATION_EVIDENCE_SUFFICIENCY_THRESHOLD=0.70
DEEPRESEARCH_EVALUATION_CONTINUE_RESEARCH_THRESHOLD=0.70
DEEPRESEARCH_EVALUATION_CONFIDENCE_FLOOR_THRESHOLD=0.50
