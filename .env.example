# 任意兼容 OpenAI Chat Completions 协议的模型服务都可以接入。
# 下面以 DeepSeek 为例；不要把真实密钥提交到 Git。
DEEPRESEARCH_API_KEY=sk-your-api-key
DEEPRESEARCH_MODEL=deepseek-chat
DEEPRESEARCH_BASE_URL=https://api.deepseek.com

# 长期记忆默认关闭。改为 default 后使用 Markdown truth store + BM25 召回。
DEEPRESEARCH_MEMORY_USE=
DEEPRESEARCH_MEMORY_STORAGE_PATH=.deepresearch/memory
DEEPRESEARCH_MEMORY_NAMESPACE=default
DEEPRESEARCH_MEMORY_ENABLE_RECALL=true
DEEPRESEARCH_MEMORY_ENABLE_EXTRACT=false
DEEPRESEARCH_MEMORY_TOKEN_BUDGET=2000
DEEPRESEARCH_MEMORY_TOP_K=5
DEEPRESEARCH_MEMORY_MIN_STRENGTH=0.0
DEEPRESEARCH_MEMORY_FORGET_THRESHOLD=0.1
DEEPRESEARCH_MEMORY_TTL_HOURS=720
DEEPRESEARCH_MEMORY_CONSOLIDATE_THRESHOLD=10
DEEPRESEARCH_MEMORY_WORKER_QUEUE_SIZE=32
